        "# ============================================================\n",
        "# IN-DOMAIN EXTERNAL VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "ext_domain = external[external[\"In_Domain\"]].copy()\n",
        "\n",
        "X_domain = ext_domain[features].astype(float)\n",
        "y_domain = ext_domain[\"Experimental_Label\"].astype(int)\n",
        "\n",
        "pred_domain = final_rf.predict(X_domain)\n",
        "prob_domain = final_rf.predict_proba(X_domain)[:,1]\n",
        "\n",
        "cm2 = confusion_matrix(y_domain, pred_domain)\n",
        "\n",
        "TN2, FP2, FN2, TP2 = cm2.ravel()\n",
        "\n",
        "acc2 = accuracy_score(y_domain, pred_domain)\n",
        "sen2 = recall_score(y_domain, pred_domain)\n",
        "spe2 = TN2/(TN2+FP2)\n",
        "pre2 = precision_score(y_domain, pred_domain)\n",
        "f12 = f1_score(y_domain, pred_domain)\n",
        "mcc2 = matthews_corrcoef(y_domain, pred_domain)\n",
        "auc2 = roc_auc_score(y_domain, prob_domain)\n",
        "prauc2 = average_precision_score(y_domain, prob_domain)\n",
        "\n",
        "domain_results = pd.DataFrame([{\n",
        "    \"Dataset\":\"Applicability-domain subset\",\n",
        "    \"N\":len(y_domain),\n",
        "    \"TN\":TN2,\n",
        "    \"FP\":FP2,\n",
        "    \"FN\":FN2,\n",
        "    \"TP\":TP2,\n",
        "    \"Accuracy\":acc2,\n",
        "    \"Sensitivity\":sen2,\n",
        "    \"Specificity\":spe2,\n",
        "    \"Precision\":pre2,\n",
        "    \"F1\":f12,\n",
        "    \"MCC\":mcc2,\n",
        "    \"ROC_AUC\":auc2,\n",
        "    \"PR_AUC\":prauc2\n",
        "}])\n",
        "\n",
        "display(domain_results.round(4))"
      ],
