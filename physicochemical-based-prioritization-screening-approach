        "    (\"field[]\", \"13\")   # Molecular weight\n",
        "]\n",
        "\n",
        "r2 = session.post(\n",
        "    submit_url,\n",
        "    data=data_list,\n",
        "    headers=headers,\n",
        "    timeout=120\n",
        ")\n",
        "\n",
        "print(\"\\nSubmission status:\", r2.status_code)\n",
