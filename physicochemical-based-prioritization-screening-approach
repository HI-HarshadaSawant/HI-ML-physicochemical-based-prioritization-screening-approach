      "source": [
        "# ============================================================\n",
        "# RESTORE ORIGINAL 203-PEPTIDE DEVELOPMENT DATASET\n",
        "# ============================================================\n",
        "\n",
        "df = pd.read_csv(\n",
        "    \"/content/Peptide_toxin (1).csv\"\n",
        ")\n",
        "\n",
        "# Remove only completely empty/unnamed columns\n",
        "df = df.loc[\n",
        "    :,\n",
        "    ~df.columns.str.startswith(\"Unnamed\")\n",
        "]\n",
        "\n",
        "# Create binary labels\n",
        "df[\"Toxin_Label\"] = (\n",
        "    df[\"Toxin\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        "    .map({\n",
        "        \"toxin\": 1,\n",
        "        \"non-toxin\": 0,\n",
        "        \"nontoxin\": 0,\n",
        "        \"non toxin\": 0\n",
        "    })\n",
        ")\n",
        "\n",
        "# Convert descriptors to numeric\n",
        "features = [\n",
        "    \"Hydrophobicity\",\n",
        "    \"Hydropathicity\",\n",
        "    \"Hydrophilicity\",\n",
        "    \"Charge\",\n",
        "    \"MW\"\n",
        "]\n",
        "\n",
        "for col in features:\n",
        "    df[col] = pd.to_numeric(\n",
        "        df[col],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "# DO NOT REMOVE DUPLICATE SEQUENCES\n",
        "# DO NOT DROP ROWS\n",
        "\n",
        "print(\"Total peptides:\", len(df))\n",
        "\n",
        "print(\"\\nClass distribution:\")\n",
        "print(\n",
        "    df[\"Toxin_Label\"].value_counts()\n",
        ")\n",
        "\n",
        "print(\"\\nMissing descriptor values:\")\n",
        "\n",
        "for col in features:\n",
        "    print(\n",
        "        col,\n",
        "        \":\",\n",
        "        df[col].isna().sum()\n",
        "    )"
      ],
