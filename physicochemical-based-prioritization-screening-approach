        "# ============================================================\n",
        "# CALCULATE AND VALIDATE MOLECULAR WEIGHT\n",
        "# ============================================================\n",
        "\n",
        "from Bio.SeqUtils.ProtParam import ProteinAnalysis\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Reload original dataset\n",
        "df = pd.read_csv(\n",
        "    \"/content/Peptide_toxin (1).csv\"\n",
        ")\n",
        "\n",
        "# Clean sequence\n",
        "df[\"Sequences\"] = (\n",
        "    df[\"Sequences\"]\n",
        "    .astype(str)\n",
        "    .str.upper()\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "# Convert existing MW to numeric\n",
        "df[\"MW\"] = pd.to_numeric(\n",
        "    df[\"MW\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Function to calculate peptide molecular weight\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def calculate_mw(sequence):\n",
        "\n",
        "    try:\n",
        "        return ProteinAnalysis(\n",
        "            sequence\n",
        "        ).molecular_weight()\n",
        "\n",
        "    except Exception:\n",
        "        return np.nan\n",
        "\n",
        "\n",
        "# Calculate MW for ALL sequences\n",
        "df[\"MW_calculated\"] = (\n",
        "    df[\"Sequences\"]\n",
        "    .apply(calculate_mw)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Compare calculated MW with existing MW\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "comparison = df[\n",
        "    df[\"MW\"].notna()\n",
        "].copy()\n",
        "\n",
        "comparison[\"Difference\"] = (\n",
        "    comparison[\"MW_calculated\"]\n",
        "    - comparison[\"MW\"]\n",
        ")\n",
        "\n",
        "comparison[\"Absolute_Difference\"] = (\n",
        "    comparison[\"Difference\"]\n",
        "    .abs()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Number of peptides with existing MW:\",\n",
        "    len(comparison)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nMean absolute difference:\",\n",
        "    comparison[\n",
        "        \"Absolute_Difference\"\n",
        "    ].mean()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Maximum absolute difference:\",\n",
        "    comparison[\n",
        "        \"Absolute_Difference\"\n",
        "    ].max()\n",
        ")\n",
        "\n",
        "display(\n",
        "    comparison[\n",
        "        [\n",
        "            \"Sequences\",\n",
        "            \"MW\",\n",
        "            \"MW_calculated\",\n",
        "            \"Difference\"\n",
        "        ]\n",
        "    ].head(20)\n",
        ")"
      ],
