        "# ============================================================\n",
        "# CELL 12: INTERNAL CONFUSION MATRIX\n",
        "# USE SINGLE STRATIFIED 5-FOLD FOR OOF PREDICTIONS\n",
        "# ============================================================\n",
        "\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import confusion_matrix\n",
        "import numpy as np\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# IMPORTANT:\n",
        "# RepeatedStratifiedKFold is used for mean performance.\n",
        "# A single StratifiedKFold is used for OOF predictions,\n",
        "# because cross_val_predict requires a true partition.\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "cv_oof = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "internal_detailed_results = []\n",
        "\n",
        "for model_name, model in models.items():\n",
        "\n",
        "    print(\"\\n===================================\")\n",
        "    print(model_name)\n",
        "    print(\"===================================\")\n",
        "\n",
        "    # Out-of-fold predictions\n",
        "    y_pred = cross_val_predict(\n",
        "        model,\n",
        "        X,\n",
        "        y,\n",
        "        cv=cv_oof,\n",
        "        method=\"predict\",\n",
        "        n_jobs=-1\n",
        "    )\n",
        "\n",
        "    # Out-of-fold probabilities\n",
        "    y_prob = cross_val_predict(\n",
        "        model,\n",
        "        X,\n",
        "        y,\n",
        "        cv=cv_oof,\n",
        "        method=\"predict_proba\",\n",
        "        n_jobs=-1\n",
        "    )[:, 1]\n",
        "\n",
        "    # Confusion matrix\n",
        "    cm = confusion_matrix(\n",
        "        y,\n",
        "        y_pred\n",
        "    )\n",
        "\n",
        "    TN, FP, FN, TP = cm.ravel()\n",
        "\n",
        "    # Metrics\n",
        "    accuracy = accuracy_score(\n",
        "        y,\n",
        "        y_pred\n",
        "    )\n",
        "\n",
        "    sensitivity = TP / (TP + FN)\n",
        "\n",
        "    specificity = TN / (TN + FP)\n",
        "\n",
        "    precision = precision_score(\n",
        "        y,\n",
        "        y_pred,\n",
        "        zero_division=0\n",
        "    )\n",
        "\n",
        "    f1 = f1_score(\n",
        "        y,\n",
        "        y_pred,\n",
        "        zero_division=0\n",
        "    )\n",
        "\n",
        "    mcc = matthews_corrcoef(\n",
        "        y,\n",
        "        y_pred\n",
        "    )\n",
        "\n",
        "    roc_auc = roc_auc_score(\n",
        "        y,\n",
        "        y_prob\n",
        "    )\n",
        "\n",
        "    pr_auc = average_precision_score(\n",
        "        y,\n",
        "        y_prob\n",
        "    )\n",
        "\n",
        "    # Print results\n",
        "    print(\"\\nConfusion Matrix:\")\n",
        "    print(cm)\n",
        "\n",
        "    print(\"\\nTN:\", TN)\n",
