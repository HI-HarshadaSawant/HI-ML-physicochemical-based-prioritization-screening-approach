        "# ============================================================\n",
        "# TOXINPRED DESCRIPTOR TEST — CORRECT FASTA FORMAT\n",
        "# ============================================================\n",
        "\n",
        "import requests\n",
        "from bs4 import BeautifulSoup\n",
        "import pandas as pd\n",
        "\n",
        "# ToxinPred URLs\n",
        "quant_url = \"https://webs.iiitd.edu.in/raghava/toxinpred/quant.php\"\n",
        "submit_url = \"https://webs.iiitd.edu.in/raghava/toxinpred/quant_submit.php\"\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Take 5 peptides from your development dataset\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "test_df = df[\n",
        "    [\n",
        "        \"Sequences\",\n",
        "        \"Hydrophobicity\",\n",
        "        \"Hydropathicity\",\n",
        "        \"Hydrophilicity\",\n",
        "        \"Charge\",\n",
        "        \"MW\"\n",
        "    ]\n",
        "].head(5).copy()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# IMPORTANT: FASTA FORMAT\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "fasta = \"\"\n",
        "\n",
        "for i, seq in enumerate(test_df[\"Sequences\"], start=1):\n",
        "    fasta += f\">seq{i}\\n{seq}\\n\"\n",
        "\n",
        "print(\"FASTA submitted to ToxinPred:\")\n",
        "print(fasta)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Start session\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "session = requests.Session()\n",
        "\n",
        "headers = {\n",
        "    \"User-Agent\": \"Mozilla/5.0\",\n",
        "    \"Referer\": quant_url\n",
        "}\n",
        "\n",
        "r1 = session.get(\n",
        "    quant_url,\n",
        "    headers=headers,\n",
        "    timeout=60\n",
        ")\n",
        "\n",
        "print(\"Initial page:\", r1.status_code)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Submit form\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "data = {\n",
        "    \"seq\": fasta,\n",
        "    \"method\": \"1\",\n",
        "    \"thval\": \"0.0\"\n",
        "}\n",
        "\n",
        "# field[] must be sent multiple times\n",
        "data_list = [\n",
        "    (\"seq\", fasta),\n",
        "    (\"method\", \"1\"),\n",
        "    (\"thval\", \"0.0\"),\n",
        "    (\"field[]\", \"4\"),   # Hydrophobicity\n",
