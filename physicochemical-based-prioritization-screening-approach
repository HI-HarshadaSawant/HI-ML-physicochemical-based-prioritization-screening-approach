        "print(\"\\nLabel distribution:\")\n",
        "print(df[\"Toxin_Label\"].value_counts())\n",
        "\n",
        "# Convert descriptors to numeric\n",
        "features = [\n",
        "    \"Hydrophobicity\",\n",
