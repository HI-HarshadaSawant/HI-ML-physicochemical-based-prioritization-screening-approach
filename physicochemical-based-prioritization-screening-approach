      "source": [
        "# ============================================================\n",
        "# PYTHON CALCULATION OF TOXINPRED-STYLE DESCRIPTORS\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. AMINO-ACID SCALES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Eisenberg hydrophobicity\n",
        "EISENBERG = {\n",
        "    \"A\": 0.25, \"R\": -1.80, \"N\": -0.64, \"D\": -0.72,\n",
        "    \"C\": 0.04, \"Q\": -0.69, \"E\": -0.62, \"G\": 0.16,\n",
        "    \"H\": -0.40, \"I\": 0.73, \"L\": 0.53, \"K\": -1.10,\n",
        "    \"M\": 0.26, \"F\": 1.13, \"P\": -0.07, \"S\": -0.26,\n",
        "    \"T\": -0.18, \"W\": 0.88, \"Y\": 0.58, \"V\": 0.54\n",
        "}\n",
        "\n",
        "# Kyte-Doolittle hydropathicity\n",
        "KYTE_DOOLITTLE = {\n",
        "    \"A\": 1.8, \"R\": -4.5, \"N\": -3.5, \"D\": -3.5,\n",
        "    \"C\": 2.5, \"Q\": -3.5, \"E\": -3.5, \"G\": -0.4,\n",
        "    \"H\": -3.2, \"I\": 4.5, \"L\": 3.8, \"K\": -3.9,\n",
        "    \"M\": 1.9, \"F\": 2.8, \"P\": -1.6, \"S\": -0.8,\n",
        "    \"T\": -0.7, \"W\": -0.9, \"Y\": -1.3, \"V\": 4.2\n",
        "}\n",
        "\n",
        "# Hopp-Woods hydrophilicity\n",
        "HOPP_WOODS = {\n",
        "    \"A\": -0.5, \"R\": 3.0, \"N\": 0.2, \"D\": 3.0,\n",
        "    \"C\": -1.0, \"Q\": 0.2, \"E\": 3.0, \"G\": 0.0,\n",
        "    \"H\": -0.5, \"I\": -1.8, \"L\": -1.8, \"K\": 3.0,\n",
        "    \"M\": -1.3, \"F\": -2.5, \"P\": 0.0, \"S\": 0.3,\n",
        "    \"T\": -0.4, \"W\": -3.4, \"Y\": -2.3, \"V\": -1.5\n",
        "}\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. DESCRIPTOR FUNCTIONS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def average_scale(sequence, scale):\n",
        "\n",
        "    sequence = sequence.upper().strip()\n",
        "\n",
        "    return np.mean([\n",
        "        scale[aa]\n",
        "        for aa in sequence\n",
        "    ])\n",
        "\n",
        "\n",
        "def calculate_charge(sequence):\n",
        "\n",
        "    sequence = sequence.upper().strip()\n",
        "\n",
        "    charge = 0.0\n",
        "\n",
        "    for aa in sequence:\n",
        "\n",
        "        if aa in [\"K\", \"R\"]:\n",
        "            charge += 1.0\n",
        "\n",
        "        elif aa in [\"D\", \"E\"]:\n",
        "            charge -= 1.0\n",
        "\n",
        "        elif aa == \"H\":\n",
        "            charge += 0.5\n",
        "\n",
        "    return charge\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. TEST ON YOUR KNOWN TRAINING PEPTIDE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sequence = \"AKMKCHTTATMKIV\"\n",
        "\n",
        "result = {\n",
        "\n",
        "    \"Sequence\": sequence,\n",
        "\n",
        "    \"Hydrophobicity\":\n",
        "        average_scale(\n",
        "            sequence,\n",
        "            EISENBERG\n",
        "        ),\n",
        "\n",
        "    \"Hydropathicity\":\n",
        "        average_scale(\n",
        "            sequence,\n",
        "            KYTE_DOOLITTLE\n",
        "        ),\n",
        "\n",
        "    \"Hydrophilicity\":\n",
        "        average_scale(\n",
        "            sequence,\n",
        "            HOPP_WOODS\n",
        "        ),\n",
        "\n",
        "    \"Charge\":\n",
        "        calculate_charge(sequence)\n",
        "}\n",
        "\n",
        "print(pd.DataFrame([result]).round(2))"
