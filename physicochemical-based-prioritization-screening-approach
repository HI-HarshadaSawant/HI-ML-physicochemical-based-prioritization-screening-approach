        "]\n",
        "\n",
        "# Create binary label\n",
        "df[\"Toxin_Label\"] = (\n",
        "    df[\"Toxin\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
